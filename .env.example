# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://upcscanning:upcscanning@localhost:5432/upcscanning?schema=public"

# Public base URL of the app (used in export CSVs for image links).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Queue
#   redis  - production. Requires REDIS_URL and a running `npm run worker`.
#   inline - no Redis. Products are processed in-process, in the background.
#            Fine for local development and small batches.
# ---------------------------------------------------------------------------
QUEUE_DRIVER="inline"
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY="3"

# ---------------------------------------------------------------------------
# Storage
#   local - writes under STORAGE_LOCAL_DIR
#   s3    - any S3-compatible bucket (AWS, R2, MinIO, Spaces)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# THE ONE KEY THAT MATTERS
#
# With just this set, the platform can identify products, search the web for
# real photos, and generate one when nothing exists. Everything below it is an
# optional upgrade.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Workflow A - finding the real product image
# Every provider is optional. Those left blank are skipped; the pipeline uses
# whatever is configured and falls through to Workflow B if nothing matches.
# ---------------------------------------------------------------------------

# Barcode databases. These resolve a UPC/EAN to product details AND images,
# which is what lets you upload nothing but a column of barcodes.
#
# UPCitemdb works with no key on a ~100/day trial; the Open Facts databases
# (food, beauty, pet food, general products) are free and unlimited. A key here
# raises the ceiling for high-volume use.
UPCITEMDB_API_KEY=""
GOUPC_API_KEY=""

# Image search through OpenAI's hosted web-search tool. On by default whenever
# OPENAI_API_KEY is set; set to "off" to stop the model browsing.
OPENAI_WEB_SEARCH="on"
OPENAI_SEARCH_MODEL="gpt-4o-mini"

# Dedicated image-search APIs. Faster and cheaper per lookup than the model,
# and worth adding once volume justifies it.

# Google Programmable Search (image search). Needs both values.
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ENGINE_ID=""

# Bing Image Search v7.
BING_SEARCH_API_KEY=""

# SerpAPI (Google Images via a single key).
SERPAPI_KEY=""

# ---------------------------------------------------------------------------
# Workflow B - AI image generation
#   auto      - use whichever provider below has a key (default)
#   openai    - gpt-image-1
#   replicate - any image model, set REPLICATE_MODEL
#   stability - Stability AI
#   none      - disable generation; products with no real image simply fail
# ---------------------------------------------------------------------------
IMAGE_GENERATION_PROVIDER="auto"

OPENAI_IMAGE_MODEL="gpt-image-1"

REPLICATE_API_TOKEN=""
REPLICATE_MODEL="black-forest-labs/flux-1.1-pro"

STABILITY_API_KEY=""
STABILITY_MODEL="sd3.5-large"

# ---------------------------------------------------------------------------
# Product understanding (brand/model normalisation, search queries, prompts).
#
# Uses ANTHROPIC_API_KEY if present, otherwise OPENAI_API_KEY, otherwise
# deterministic heuristics. One key of either kind is enough.
# ---------------------------------------------------------------------------
OPENAI_TEXT_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# Background removal
#   auto     - sharp-based flood fill; free, works well on catalog photos
#   removebg - remove.bg API, needs REMOVEBG_API_KEY
#   none     - keep the original background
# ---------------------------------------------------------------------------
BACKGROUND_REMOVAL_PROVIDER="auto"
REMOVEBG_API_KEY=""

# ---------------------------------------------------------------------------
# Barcode lookup cache
#
# A GTIN identifies the same product forever, and supplier lists overlap
# heavily, so lookups are cached and shared across every batch and user. This
# is what makes the keyless tier (UPCitemdb's ~100/day trial) usable in bulk,
# and it keeps repeat uploads from re-spending your search budget.
# ---------------------------------------------------------------------------
LOOKUP_CACHE_ENABLED="true"
LOOKUP_CACHE_TTL_DAYS="90"
# Misses expire sooner, since a database may add the product later.
LOOKUP_CACHE_MISS_TTL_DAYS="7"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
JPEG_COMPRESSION="fast"
MAX_UPLOAD_BYTES="52428800"
MAX_PRODUCTS_PER_BATCH="5000"
MAX_IMAGE_DOWNLOAD_BYTES="15728640"
HTTP_TIMEOUT_MS="20000"
